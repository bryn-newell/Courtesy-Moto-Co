 icons: {\n    icon: [\n      {\n        url: '/icon-light-32x32.png',\n        media: '(prefers-color-scheme: light)',\n      },\n      {\n        url: '/icon-dark-32x32.png',\n        media: '(prefers-color-scheme: dark)',\n      },\n      {\n        url: '/icon.svg',\n        type: 'image/svg+xml',\n      },\n    ],\n    apple: '/apple-icon.png',\n  },\n}\n\nexport default function RootLayout({\n  children,\n}: Readonly\u003c{\n  children: React.ReactNode\n}\u003e) {\n  return (\n    \u003chtml lang=\"en\"\u003e\n      \u003cbody className={`font-sans antialiased`}\u003e\n        {children}\n        \u003cAnalytics /\u003e\n      \u003c/body\u003e\n    \u003c/html\u003e\n  )\n}\n21:T214b,"])</script><script>self.__next_f.push([1,"import Image from \"next/image\";\nimport { MapPin, Phone, Mail, Clock, Download } from \"lucide-react\";\n\nexport default function HomePage() {\n  return (\n    \u003cmain className=\"min-h-screen bg-background\"\u003e\n      {/* Hero Section */}\n      \u003csection className=\"min-h-screen flex flex-col\"\u003e\n        {/* Header */}\n        \u003cheader className=\"flex items-center justify-between px-6 py-6 md:px-12 lg:px-20 bg-background border-b border-border\"\u003e\n          \u003cdiv className=\"flex items-center gap-2\"\u003e\n            \u003cspan className=\"text-muted-foreground font-serif text-sm tracking-[0.3em] uppercase\"\u003e\n              Est. 2025\n            \u003c/span\u003e\n          \u003c/div\u003e\n          \u003ca\n            href=\"/courtesy-moto-info.pdf\"\n            download\n            className=\"flex items-center gap-2 text-muted-foreground hover:text-foreground transition-colors text-sm tracking-wide\"\n          \u003e\n            \u003cDownload className=\"w-4 h-4\" /\u003e\n            \u003cspan className=\"hidden sm:inline\"\u003eDownload Info\u003c/span\u003e\n          \u003c/a\u003e\n        \u003c/header\u003e\n\n        {/* Hero Content - Split Layout */}\n        \u003cdiv className=\"flex-1 grid lg:grid-cols-2\"\u003e\n          {/* Text Content */}\n          \u003cdiv className=\"flex flex-col justify-center px-6 py-16 md:px-12 lg:px-20 bg-background order-2 lg:order-1\"\u003e\n            \u003cp className=\"text-primary tracking-[0.4em] uppercase text-xs md:text-sm mb-6\"\u003e\n              Coming Soon\n            \u003c/p\u003e\n            \u003ch1 className=\"font-serif text-5xl md:text-6xl lg:text-7xl text-foreground tracking-tight text-balance\"\u003e\n              Courtesy\n              \u003cbr /\u003e\n              Moto Co.\n            \u003c/h1\u003e\n            \u003cdiv className=\"w-24 h-px bg-border my-8\" /\u003e\n            \u003cp className=\"text-muted-foreground text-lg md:text-xl max-w-md leading-relaxed\"\u003e\n              Classic motorcycle service, restoration, and sales. Where tradition meets the open road.\n            \u003c/p\u003e\n            \u003cdiv className=\"mt-10 flex flex-col sm:flex-row gap-4\"\u003e\n              \u003ca\n                href=\"/courtesy-moto-info.pdf\"\n                download\n                className=\"inline-flex items-center justify-center gap-3 bg-primary text-primary-foreground px-6 py-3 font-sans tracking-wide hover:bg-primary/90 transition-colors\"\n              \u003e\n                \u003cDownload className=\"w-5 h-5\" /\u003e\n                Download Info Packet\n              \u003c/a\u003e\n              \u003ca\n                href=\"mailto:hello@courtesymoto.com\"\n                className=\"inline-flex items-center justify-center gap-3 border border-border text-foreground px-6 py-3 font-sans tracking-wide hover:bg-muted transition-colors\"\n              \u003e\n                \u003cMail className=\"w-5 h-5\" /\u003e\n                Get In Touch\n              \u003c/a\u003e\n            \u003c/div\u003e\n          \u003c/div\u003e\n\n          {/* Image */}\n          \u003cdiv className=\"relative min-h-[50vh] lg:min-h-full order-1 lg:order-2\"\u003e\n            \u003cImage\n              src=\"/images/vintage-motorcycle.jpg\"\n              alt=\"Classic vintage motorcycle parked on an asphalt road in golden hour sunlight\"\n              fill\n              className=\"object-cover\"\n              priority\n            /\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n      \u003c/section\u003e\n\n      {/* Info Section */}\n      \u003csection className=\"bg-background py-20 md:py-32 px-6 md:px-12 lg:px-20\"\u003e\n        \u003cdiv className=\"max-w-6xl mx-auto\"\u003e\n          {/* Section Header */}\n          \u003cdiv className=\"text-center mb-16 md:mb-24\"\u003e\n            \u003cp className=\"text-muted-foreground tracking-[0.3em] uppercase text-xs mb-4\"\u003e\n              Opening Soon\n            \u003c/p\u003e\n            \u003ch2 className=\"font-serif text-3xl md:text-5xl text-foreground tracking-tight text-balance\"\u003e\n              Your Neighborhood\n              \u003cbr /\u003e\n              Motorcycle Destination\n            \u003c/h2\u003e\n          \u003c/div\u003e\n\n          {/* Info Cards */}\n          \u003cdiv className=\"grid md:grid-cols-3 gap-8 md:gap-12\"\u003e\n            {/* Location */}\n            \u003cdiv className=\"text-center group\"\u003e\n              \u003cdiv className=\"w-16 h-16 mx-auto mb-6 rounded-full border border-border flex items-center justify-center group-hover:border-primary group-hover:bg-primary/5 transition-all\"\u003e\n                \u003cMapPin className=\"w-6 h-6 text-primary\" /\u003e\n              \u003c/div\u003e\n              \u003ch3 className=\"font-serif text-xl text-foreground mb-3\"\u003eVisit Us\u003c/h3\u003e\n              \u003cp className=\"text-muted-foreground leading-relaxed\"\u003e\n                1234 Main Street\n                \u003cbr /\u003e\n                Downtown District\n                \u003cbr /\u003e\n                Portland, OR 97201\n              \u003c/p\u003e\n            \u003c/div\u003e\n\n            {/* Contact */}\n            \u003cdiv className=\"text-center group\"\u003e\n              \u003cdiv className=\"w-16 h-16 mx-auto mb-6 rounded-full border border-border flex items-center justify-center group-hover:border-primary group-hover:bg-primary/5 transition-all\"\u003e\n                \u003cPhone className=\"w-6 h-6 text-primary\" /\u003e\n              \u003c/div\u003e\n              \u003ch3 className=\"font-serif text-xl text-foreground mb-3\"\u003eGet In Touch\u003c/h3\u003e\n              \u003cdiv className=\"text-muted-foreground leading-relaxed space-y-1\"\u003e\n                \u003cp\u003e\n                  \u003ca href=\"tel:+15035551234\" className=\"hover:text-primary transition-colors\"\u003e\n                    (503) 555-1234\n                  \u003c/a\u003e\n                \u003c/p\u003e\n                \u003cp\u003e\n                  \u003ca href=\"mailto:hello@courtesymoto.com\" className=\"hover:text-primary transition-colors\"\u003e\n                    hello@courtesymoto.com\n                  \u003c/a\u003e\n                \u003c/p\u003e\n              \u003c/div\u003e\n            \u003c/div\u003e\n\n            {/* Hours */}\n            \u003cdiv className=\"text-center group\"\u003e\n              \u003cdiv className=\"w-16 h-16 mx-auto mb-6 rounded-full border border-border flex items-center justify-center group-hover:border-primary group-hover:bg-primary/5 transition-all\"\u003e\n                \u003cClock className=\"w-6 h-6 text-primary\" /\u003e\n              \u003c/div\u003e\n              \u003ch3 className=\"font-serif text-xl text-foreground mb-3\"\u003eHours\u003c/h3\u003e\n              \u003cp className=\"text-muted-foreground leading-relaxed\"\u003e\n                Monday – Friday: 9am – 6pm\n                \u003cbr /\u003e\n                Saturday: 10am – 4pm\n                \u003cbr /\u003e\n                Sunday: Closed\n              \u003c/p\u003e\n            \u003c/div\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n      \u003c/section\u003e\n\n      {/* CTA Section */}\n      \u003csection className=\"bg-primary py-16 md:py-24 px-6 md:px-12 lg:px-20\"\u003e\n        \u003cdiv className=\"max-w-4xl mx-auto text-center\"\u003e\n          \u003ch2 className=\"font-serif text-2xl md:text-4xl text-primary-foreground mb-6 text-balance\"\u003e\n            Stay Updated on Our Grand Opening\n          \u003c/h2\u003e\n          \u003cp className=\"text-primary-foreground/80 mb-8 max-w-xl mx-auto\"\u003e\n            Download our information packet to learn more about services, pricing, and special opening day promotions.\n          \u003c/p\u003e\n          \u003ca\n            href=\"/courtesy-moto-info.pdf\"\n            download\n            className=\"inline-flex items-center gap-3 bg-primary-foreground text-primary px-8 py-4 font-sans tracking-wide hover:bg-primary-foreground/90 transition-colors\"\n          \u003e\n            \u003cDownload className=\"w-5 h-5\" /\u003e\n            Download Info Packet\n          \u003c/a\u003e\n        \u003c/div\u003e\n      \u003c/section\u003e\n\n      {/* Footer */}\n      \u003cfooter className=\"bg-foreground py-12 px-6 md:px-12 lg:px-20\"\u003e\n        \u003cdiv className=\"max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6\"\u003e\n          \u003cdiv className=\"text-center md:text-left\"\u003e\n            \u003cp className=\"font-serif text-xl text-primary-foreground\"\u003eCourtesy Moto Co.\u003c/p\u003e\n            \u003cp className=\"text-primary-foreground/50 text-sm mt-1\"\u003eClassic Motorcycles Since 2025\u003c/p\u003e\n          \u003c/div\u003e\n          \u003cdiv className=\"flex items-center gap-6\"\u003e\n            \u003ca\n              href=\"mailto:hello@courtesymoto.com\"\n              className=\"text-primary-foreground/60 hover:text-primary-foreground transition-colors\"\n              aria-label=\"Email us\"\n            \u003e\n              \u003cMail className=\"w-5 h-5\" /\u003e\n            \u003c/a\u003e\n            \u003ca\n              href=\"tel:+15035551234\"\n              className=\"text-primary-foreground/60 hover:text-primary-foreground transition-colors\"\n              aria-label=\"Call us\"\n            \u003e\n              \u003cPhone className=\"w-5 h-5\" /\u003e\n            \u003c/a\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n        \u003cdiv className=\"max-w-6xl mx-auto mt-8 pt-8 border-t border-primary-foreground/10\"\u003e\n          \u003cp className=\"text-center text-primary-foreground/40 text-sm\"\u003e\n            © 2025 Courtesy Moto Co. All rights reserved.\n          \u003c/p\u003e\n        \u003c/div\u003e\n      \u003c/footer\u003e\n    \u003c/main\u003e\n  );\n}\n"])</script><script>self.__next_f.push([1,"19:[\"$\",\"$L1c\",null,{\"id\":\"b_FomJ3hVoEAg\",\"loadClientFiles\":\"$h1d\",\"chatMetadata\":{\"tailwindV4Default\":true,\"title\":\"Courtesy Moto landing page\",\"context\":{\"ai\":false},\"isFigmaChat\":false,\"isMultiFile\":true,\"isAgentEnabled\":true,\"nextVersionDefault\":16},\"isV3\":false,\"files\":[[\"app/globals.css\",{\"type\":\"file\",\"data\":\"$1e\"}],[\"public/images/vintage-motorcycle.jpg\",{\"type\":\"url\",\"data\":\"https://hebbkx1anhila5yf.public.blob.vercel-storage.com/attachments/gen-images/public/images/vintage-motorcycle-a8T1CsEVX9gDgt1Aa9T9pxtDD9Nfzn.jpg\"}],[\"package.json\",{\"type\":\"file\",\"data\":\"$1f\"}],[\"app/layout.tsx\",{\"type\":\"file\",\"data\":\"$20\"}],[\"app/page.tsx\",{\"type\":\"file\",\"data\":\"$21\"}]],\"createdAt\":1769704620278,\"defaultPath\":\"/courtesy-moto-info.pdf\",\"envPromise\":\"$@22\",\"expectSnowflake\":false}]\n"])</script><script>self.__next_f.push([1,"1b:[]\n22:[]\n"])</script><script src="/assets/tailwind-v4.js?v=1" async="" fetchPriority="high"></script><div hidden id="S:1"><style id="default-global-styles-just-animation" type="text/t